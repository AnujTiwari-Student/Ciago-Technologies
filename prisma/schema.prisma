generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

model AttendanceRecord {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  workDate             DateTime  @map("work_date") @db.Date
  checkIn              DateTime? @map("check_in") @db.Timestamptz(6)
  checkOut             DateTime? @map("check_out") @db.Timestamptz(6)
  hours                Decimal?  @db.Decimal(5, 2)
  status               String    @default("present")
  regularizationReason String?   @map("regularization_reason")
  regularizedBy        String?   @map("regularized_by") @db.Uuid
  regularizedAt        DateTime? @map("regularized_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, workDate])
  @@map("attendance_records")
  @@schema("public")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp      DateTime @default(now()) @db.Timestamptz(6)
  actorId        String?  @map("actor_id") @db.Uuid
  actorEmail     String?  @map("actor_email")
  action         String
  targetResource String?  @map("target_resource")
  details        Json     @default("{}")

  @@map("audit_logs")
  @@schema("public")
}

model ClerkUserMap {
  clerkUserId          String   @id @map("clerk_user_id")
  authUserId           String   @unique @map("auth_user_id") @db.Uuid
  email                String?  @unique
  primaryEmailVerified Boolean  @default(false) @map("primary_email_verified")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([authUserId])
  @@index([email], where: raw("(email IS NOT NULL)"))
  @@map("clerk_user_map")
  @@schema("public")
}

model Department {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("departments")
  @@schema("public")
}

model Employee {
  userId                     String                      @id @map("user_id") @db.Uuid
  workEmail                  String?                     @map("work_email")
  personalEmail              String?                     @map("personal_email")
  contactNumber              String?                     @map("contact_number")
  address                    String?
  department                 DeptType?
  teamName                   String?                     @map("team_name")
  designation                String?
  reportingManagerId         String?                     @map("reporting_manager_id") @db.Uuid
  reportingHrId              String?                     @map("reporting_hr_id") @db.Uuid
  doj                        DateTime?                   @db.Date
  employmentType             String?                     @map("employment_type")
  baseSalary                 Decimal?                    @map("base_salary") @db.Decimal(14, 2)
  salaryCurrency             String                      @default("INR") @map("salary_currency")
  workModel                  String?                     @map("work_model")
  workLocation               String?                     @map("work_location")
  probationMonths            Int?                        @map("probation_months") @db.SmallInt
  probationStatus            String                      @default("under_review") @map("probation_status")
  backgroundCheckStatus      String                      @default("not_started") @map("background_check_status")
  docVerificationStatus      String                      @default("pending") @map("doc_verification_status")
  notes                      String?
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  accountStatus              String                      @default("active") @map("account_status")
  orangehrmEmployeeId        Int?                        @unique(map: "idx_employees_orangehrm_employee_active", where: raw("((orangehrm_employee_id IS NOT NULL) AND (orangehrm_record_status = 'ACTIVE'::orangehrm_record_status))")) @map("orangehrm_employee_id")
  orangehrmSystemUserId      Int?                        @unique(map: "idx_employees_orangehrm_system_user", where: raw("(orangehrm_system_user_id IS NOT NULL)")) @map("orangehrm_system_user_id")
  essAccountStatus           ESSAccountStatus            @default(not_provisioned) @map("ess_account_status")
  orangehrmRecordStatus      OrangeHRMRecordStatus       @default(ACTIVE) @map("orangehrm_record_status")
  orangehrmTerminatedAt      DateTime?                   @map("orangehrm_terminated_at") @db.Timestamptz(6)
  orangehrmTerminationReason OrangeHRMTerminationReason? @map("orangehrm_termination_reason")
  offboardingStatus          OffboardingStatus?          @map("offboarding_status")
  offboardingInitiatedAt     DateTime?                   @map("offboarding_initiated_at") @db.Timestamptz(6)
  offboardingCompletedAt     DateTime?                   @map("offboarding_completed_at") @db.Timestamptz(6)
  lastWorkingDay             DateTime?                   @map("last_working_day") @db.Date
  offboardingReason          OffboardingReason?          @map("offboarding_reason")
  frappeEmployeeName         String?                     @map("frappe_employee_name")
  frappeRecordStatus         FrappeRecordStatus          @default(ACTIVE) @map("frappe_record_status")
  frappeTerminatedAt         DateTime?                   @map("frappe_terminated_at") @db.Timestamptz(6)

  @@index([orangehrmEmployeeId], map: "idx_employees_orangehrm_employee_id", where: raw("(orangehrm_employee_id IS NOT NULL)"))
  @@index([essAccountStatus], map: "idx_employees_ess_account_status")
  @@index([orangehrmRecordStatus], map: "idx_employees_orangehrm_record_status")
  @@index([offboardingStatus], map: "idx_employees_offboarding_status")
  @@index([department], map: "idx_employees_dept")
  @@index([reportingHrId], map: "idx_employees_hr")
  @@index([reportingManagerId], map: "idx_employees_manager")
  @@index([frappeEmployeeName], map: "idx_employees_frappe_employee_name")
  @@index([frappeRecordStatus], map: "idx_employees_frappe_record_status")
  @@map("employees")
  @@schema("public")
}

model EmploymentType {
  code      String   @id
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("employment_types")
  @@schema("public")
}

model IdentityDocument {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  docType     String    @map("doc_type")
  docNumber   String?   @map("doc_number")
  storagePath String?   @map("storage_path")
  status      String    @default("pending")
  feedback    String?
  verifiedBy  String?   @map("verified_by") @db.Uuid
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, docType])
  @@map("identity_documents")
  @@schema("public")
}

model InAppNotification {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  applicationId String?  @map("application_id") @db.Uuid
  title         String
  body          String
  link          String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, read, createdAt(sort: Desc)], map: "in_app_notifications_user_idx")
  @@map("in_app_notifications")
  @@schema("public")
}

model InterviewSlot {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId   String   @map("application_id") @db.Uuid
  candidateUserId String   @map("candidate_user_id") @db.Uuid
  proposedBy      String   @map("proposed_by") @db.Uuid
  slotAt          DateTime @map("slot_at") @db.Timestamptz(6)
  location        String?
  notes           String?
  isSelected      Boolean  @default(false) @map("is_selected")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("interview_slots")
  @@schema("public")
}

model JobApplication {
  id                               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                           String                      @map("user_id") @db.Uuid
  roleId                           String                      @map("role_id") @db.Uuid
  roleTitle                        String                      @map("role_title")
  fullName                         String                      @map("full_name")
  email                            String
  portfolioUrl                     String?                     @map("portfolio_url")
  resumeStoragePath                String?                     @map("resume_storage_path")
  resumeLink                       String?                     @map("resume_link")
  status                           String                      @default("applied")
  createdAt                        DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt                        DateTime?                   @map("deleted_at") @db.Timestamptz(6)
  isSoftDeleted                    Boolean                     @default(false) @map("is_soft_deleted")
  orangehrmEmployeeId              Int?                        @unique(map: "idx_job_applications_orangehrm_employee_active", where: raw("((orangehrm_employee_id IS NOT NULL) AND (orangehrm_record_status = 'ACTIVE'::orangehrm_record_status))")) @map("orangehrm_employee_id")
  orangehrmProvisioningState       OrangeHRMProvisioningState  @default(not_started) @map("orangehrm_provisioning_state")
  orangehrmProvisioningAttemptedAt DateTime?                   @map("orangehrm_provisioning_attempted_at") @db.Timestamptz(6)
  orangehrmProvisioningSucceededAt DateTime?                   @map("orangehrm_provisioning_succeeded_at") @db.Timestamptz(6)
  orangehrmRecordStatus            OrangeHRMRecordStatus       @default(ACTIVE) @map("orangehrm_record_status")
  orangehrmTerminatedAt            DateTime?                   @map("orangehrm_terminated_at") @db.Timestamptz(6)
  orangehrmTerminationReason       OrangeHRMTerminationReason? @map("orangehrm_termination_reason")
  lifecycleVersion                 Int                         @default(1) @map("lifecycle_version")
  frappeEmployeeName               String?                     @map("frappe_employee_name")
  frappeProvisioningAttemptedAt    DateTime?                   @map("frappe_provisioning_attempted_at") @db.Timestamptz(6)
  frappeProvisioningState          FrappeProvisioningState     @default(not_started) @map("frappe_provisioning_state")
  frappeProvisioningSucceededAt    DateTime?                   @map("frappe_provisioning_succeeded_at") @db.Timestamptz(6)
  frappeRecordStatus               FrappeRecordStatus          @default(ACTIVE) @map("frappe_record_status")
  frappeTerminatedAt               DateTime?                   @map("frappe_terminated_at") @db.Timestamptz(6)
  country                          String?
  coverLetter                      String?                     @map("cover_letter")
  expectedSalaryCurrency           String?                     @default("INR") @map("expected_salary_currency")
  expectedSalaryMax                BigInt?                     @map("expected_salary_max")
  expectedSalaryMin                BigInt?                     @map("expected_salary_min")
  frappeJobApplicantName           String?                     @unique @map("frappe_job_applicant_name")
  phoneNumber                      String?                     @map("phone_number")

  @@index([orangehrmEmployeeId], map: "idx_job_applications_orangehrm_employee_id", where: raw("(orangehrm_employee_id IS NOT NULL)"))
  @@index([orangehrmRecordStatus], map: "idx_job_applications_orangehrm_record_status")
  @@index([lifecycleVersion], map: "idx_job_applications_lifecycle_version")
  @@index([roleId, createdAt(sort: Desc)], map: "job_applications_role_created_idx")
  @@index([isSoftDeleted, deletedAt], map: "job_applications_soft_deleted_idx")
  @@index([userId, roleId, createdAt(sort: Desc)], map: "job_applications_user_role_idx")
  @@index([frappeEmployeeName], map: "idx_job_applications_frappe_employee_name")
  @@index([frappeRecordStatus], map: "idx_job_applications_frappe_record_status")
  @@map("job_applications")
  @@schema("public")
}

model JobPosting {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                  String
  department             String
  location               String
  isRemote               Boolean          @default(true) @map("is_remote")
  employmentType         String           @default("Full-time") @map("employment_type")
  summary                String
  description            String
  requirements           String[]         @default([])
  tags                   String[]         @default([])
  salaryMinInr           BigInt?          @map("salary_min_inr")
  salaryMaxInr           BigInt?          @map("salary_max_inr")
  status                 JobPostingStatus @default(draft)
  createdBy              String?          @map("created_by") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  jobCode                String?          @unique @map("job_code")
  requiredOnboardingDocs String[]         @default(["aadhaar", "pan", "bank_details"]) @map("required_onboarding_docs")
  trackType              JobTrackType     @default(standard) @map("track_type")
  departmentId           String?          @map("department_id") @db.Uuid
  internalOnly           Boolean          @default(false) @map("internal_only")
  closesOn               DateTime?        @map("closes_on") @db.Date
  currency               String           @default("INR")
  designation            String?
  frappeJobOpeningName   String?          @unique @map("frappe_job_opening_name")
  publishSalaryRange     Boolean          @default(false) @map("publish_salary_range")
  salaryPaidPer          String           @default("Month") @map("salary_paid_per")

  @@index([status, createdAt(sort: Desc)], map: "job_postings_status_idx")
  @@map("job_postings")
  @@schema("public")
}

model LeaveRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  leaveType    String    @default("pto") @map("leave_type")
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime  @map("end_date") @db.Date
  reason       String?
  status       String    @default("pending")
  decidedBy    String?   @map("decided_by") @db.Uuid
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote String?   @map("decision_note")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("leave_requests")
  @@schema("public")
}

model OnboardingDocument {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  onboardingId     String    @map("onboarding_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  docKey           String    @map("doc_key")
  storagePath      String    @map("storage_path")
  originalFilename String?   @map("original_filename")
  status           String    @default("pending")
  feedback         String?
  reviewedBy       String?   @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int       @default(1)
  supersededAt     DateTime? @map("superseded_at") @db.Timestamptz(6)

  @@unique([onboardingId, docKey], map: "onboarding_documents_current_unique", where: raw("(superseded_at IS NULL)"))
  @@index([onboardingId, docKey, version(sort: Desc)], map: "onboarding_documents_history_idx")
  @@map("onboarding_documents")
  @@schema("public")
}

model OnboardingRecord {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  applicationId      String    @unique @map("application_id") @db.Uuid
  roleTitle          String    @map("role_title")
  department         String?
  startDate          DateTime? @map("start_date") @db.Date
  compensationInr    BigInt?   @map("compensation_inr")
  offerAcceptedAt    DateTime? @map("offer_accepted_at") @db.Timestamptz(6)
  offerDeclinedAt    DateTime? @map("offer_declined_at") @db.Timestamptz(6)
  emergencyContact   Json?     @map("emergency_contact")
  idAck              Boolean   @default(false) @map("id_ack")
  codeOfConductAck   Boolean   @default(false) @map("code_of_conduct_ack")
  submittedAt        DateTime? @map("submitted_at") @db.Timestamptz(6)
  status             String    @default("pending")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  doj                DateTime? @db.Date
  verificationStatus String    @default("not_submitted") @map("verification_status")
  currentStep        Int       @default(1) @map("current_step") @db.SmallInt
  rejectionFeedback  String?   @map("rejection_feedback")
  verifiedBy         String?   @map("verified_by") @db.Uuid
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  formState          Json      @default("{}") @map("form_state")

  @@map("onboarding_records")
  @@schema("public")
}

model Profile {
  userId      String   @id @map("user_id") @db.Uuid
  fullName    String?  @map("full_name")
  publicEmail String?  @map("public_email")
  bio         String?
  pronouns    String?
  website     String?
  linkedin    String?
  portfolio   String?
  leetcode    String?
  avatarPath  String?  @map("avatar_path")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
  @@schema("public")
}

model RateLimit {
  id         BigInt   @id @default(autoincrement())
  bucket     String
  key        String
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([bucket, key, occurredAt(sort: Desc)], map: "rate_limits_bucket_key_time_idx")
  @@map("rate_limits")
  @@schema("public")
}

model Referral {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  candidateName  String   @map("candidate_name")
  candidateEmail String   @map("candidate_email")
  jobPostingId   String?  @map("job_posting_id") @db.Uuid
  referralStatus String   @default("pending") @map("referral_status")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId], map: "idx_referrals_employee")
  @@index([jobPostingId], map: "idx_referrals_job_posting")
  @@map("referrals")
  @@schema("public")
}

model Resignation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  submittedOn    DateTime  @default(dbgenerated("CURRENT_DATE")) @map("submitted_on") @db.Date
  lastWorkingDay DateTime  @map("last_working_day") @db.Date
  reason         String?
  status         String    @default("pending")
  decidedBy      String?   @map("decided_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote   String?   @map("decision_note")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status], map: "idx_resignations_status")
  @@index([userId], map: "idx_resignations_user")
  @@map("resignations")
  @@schema("public")
}

model ResourceDownload {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String
  resourceSlug String   @map("resource_slug")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("resource_downloads")
  @@schema("public")
}

model SalarySlip {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  periodMonth     Int      @map("period_month")
  periodYear      Int      @map("period_year")
  workingDays     Int      @default(22) @map("working_days")
  lwpDays         Decimal  @default(0) @map("lwp_days") @db.Decimal(5, 2)
  basic           Decimal  @default(0) @db.Decimal(12, 2)
  hra             Decimal  @default(0) @db.Decimal(12, 2)
  special         Decimal  @default(0) @db.Decimal(12, 2)
  gross           Decimal  @default(0) @db.Decimal(12, 2)
  pfEmployee      Decimal  @default(0) @map("pf_employee") @db.Decimal(12, 2)
  pt              Decimal  @default(0) @db.Decimal(12, 2)
  tds             Decimal  @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal  @default(0) @map("total_deductions") @db.Decimal(12, 2)
  netPay          Decimal  @default(0) @map("net_pay") @db.Decimal(12, 2)
  generatedBy     String?  @map("generated_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, periodYear, periodMonth])
  @@map("salary_slips")
  @@schema("public")
}

model Email {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resendId      String?   @map("resend_id")
  sender        String
  recipient     String
  subject       String
  emailType     String    @map("email_type")
  status        String    @default("pending")
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)
  openedAt      DateTime? @map("opened_at") @db.Timestamptz(6)
  clickedAt     DateTime? @map("clicked_at") @db.Timestamptz(6)
  bouncedAt     DateTime? @map("bounced_at") @db.Timestamptz(6)
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(6)
  errorMessage  String?   @map("error_message")
  userId        String?   @map("user_id") @db.Uuid
  applicationId String?   @map("application_id") @db.Uuid
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([applicationId], map: "idx_emails_application_id")
  @@index([emailType], map: "idx_emails_email_type")
  @@index([resendId], map: "idx_emails_resend_id")
  @@index([status], map: "idx_emails_status")
  @@index([userId], map: "idx_emails_user_id")
  @@map("emails")
  @@schema("public")
}

model ServiceAccountMapping {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  githubUsername  String?   @map("github_username")
  teamsEmail      String?   @map("teams_email")
  clickupUsername String?   @map("clickup_username")
  orangehrmUserId Int?      @map("orangehrm_user_id")
  status          String    @default("active")
  provisionedAt   DateTime? @map("provisioned_at") @db.Timestamptz(6)
  deprovisionedAt DateTime? @map("deprovisioned_at") @db.Timestamptz(6)
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

