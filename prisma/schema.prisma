model AccessRoleMapping {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleName     String           @map("role_name")
  provider     ExternalProvider
  providerRole String           @map("provider_role")
  description  String?
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([roleName, provider], map: "access_role_mappings_unique")
  @@index([roleName], map: "idx_access_role_mappings_role_name")
  @@index([provider], map: "idx_access_role_mappings_provider")
  @@map("access_role_mappings")
}
