# Hetzner Cloud Production Configuration
# Copy to .env.hetzner and fill in your values

# MariaDB Configuration
MARIADB_ROOT_PASSWORD=YOUR_STRONG_ROOT_PASSWORD_HERE
MARIADB_PASSWORD=YOUR_STRONG_FRAPPE_PASSWORD_HERE

# Frappe Site Configuration
SITE_NAME=api.ciagotech.com
ADMIN_PASSWORD=PLMqaz2901@

# Hetzner Cloud Specifics
HETZNER_PUBLIC_IP=your.hetzner.public.ip
HETZNER_SERVER_NAME=frappe-production
HETZNER_DATACENTER=fsn1-dc14

# SSL Configuration
SSL_EMAIL=admin@ciagotech.com
SSL_DOMAIN=api.ciagotech.com

# Backup Configuration
BACKUP_RETENTION_DAYS=14
STORAGE_BOX_USER=u123456
STORAGE_BOX_HOST=u123456.your-storagebox.de

# Email Configuration (Production SMTP)
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=apikey
MAIL_PASSWORD=YOUR_SENDGRID_API_KEY

# Timezone
TZ=Asia/Kolkata

# Performance Tuning
MAX_WORKERS=4
WORKER_TIMEOUT=300
