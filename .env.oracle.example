# Oracle Cloud Free Tier Configuration
# Copy to .env.oracle and fill in your values

# MariaDB Configuration
MARIADB_ROOT_PASSWORD=YOUR_STRONG_ROOT_PASSWORD_HERE
MARIADB_PASSWORD=YOUR_STRONG_FRAPPE_PASSWORD_HERE

# Frappe Site Configuration
SITE_NAME=frappe.oracle.ciagotech.com
ADMIN_PASSWORD=PLMqaz2901@

# Oracle Cloud Specifics
ORACLE_PUBLIC_IP=your.oracle.public.ip
ORACLE_REGION=us-ashburn-1

# Backup Configuration
BACKUP_RETENTION_DAYS=7
OCI_BUCKET_NAME=frappe-backups

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Timezone
TZ=Asia/Kolkata
